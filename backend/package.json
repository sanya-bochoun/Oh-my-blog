{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for My Personal Blog",
  "type": "module",
  "main": "server.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "nodemon server.mjs",
    "build": "vercel build",
    "migrate": "node utils/dbMigrate.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "backup": "node scripts/backupDb.mjs",
    "cleanup:uploads": "node scripts/cleanupUploads.mjs old 30",
    "cleanup:uploads:unused": "node scripts/cleanupUploads.mjs unused"
  },
  "keywords": [
    "blog",
    "authentication",
    "api",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.6.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.11.3",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4"
  }
}
