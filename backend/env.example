# Backend Environment Variables

# Database Configuration (เลือกใช้แบบใดแบบหนึ่ง)
# แบบที่ 1: Connection String (สำหรับ production เช่น Supabase, Vercel)
# DATABASE_URL=postgresql://username:password@host:port/database
# Supabase Database URL format:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# แบบที่ 2: แยกส่วน (สำหรับ development) - แนะนำใช้แบบนี้ใน local
DB_USER=postgres
DB_HOST=localhost
DB_NAME=my_blog_db
DB_PASSWORD=your_password
DB_PORT=5432

JWT_SECRET=your-super-secret-jwt-key-here
NODE_ENV=development
PORT=5000

# Rate Limiting (Optional)
# Set to 'true' to completely disable rate limiting (only for development/testing)
# DISABLE_RATE_LIMIT=false

# Email Configuration (for password reset and email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Oh!myBlog

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Sentry Error Tracking (Optional)
# Get your DSN from https://sentry.io after creating a project
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# SENTRY_RELEASE=1.0.0
# SENTRY_ENABLE_DEV=false  # Set to 'true' to enable Sentry in development mode

# API Documentation (Swagger)
# API_URL=http://localhost:5000  # Base URL for API documentation
# ENABLE_SWAGGER=false  # Set to 'true' to enable Swagger UI in production

# Redis Cache (Optional)
# Use Redis URL (for Redis Cloud, Upstash, etc.)
# REDIS_URL=redis://:password@host:port
# Or use separate configuration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password 